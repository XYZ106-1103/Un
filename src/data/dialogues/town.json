 "town.pins.check": [
  {
   "if": "flag:pin1 == red && flag:pin2 == blue && flag:pin3 == gold && flag:pin4 == green",
   "then": "town.festival.light"
  },
  {
   "if": "flag:pin1 && flag:pin2 && flag:pin3 && flag:pin4",
   "then": [
    {
     "set": {
      "pins_wrong": "+1"
     }
    },
    {
     "say": "…아무 일도 일어나지 않는다. 순서가 틀린 것 같다."
    }
   ]
  }
 ],
 "town.festival.light": [
  {
   "do": "cinema",
   "on": true
  },
  {
   "do": "sfx",
   "id": "tag-chime"
  },
  {
   "set": {
    "festival_lit": true
   }
  },
  {
   "say": [
    "탁. 탁. 탁. 탁.",
    "빨랫줄을 따라 등불이 하나씩 켜진다."
   ]
  },
  {
   "do": "music",
   "id": "festival",
   "fade": 1.5
  },
  {
   "if": "hollow",
   "then": [
    {
     "say": [
      "등불이 켜졌다.",
      "…광장에는 아무도 없다."
     ]
    }
   ],
   "else": [
    {
     "say": "켜졌다아아아!",
     "who": "pip",
     "face": "surprised"
    },
    {
     "say": "올해는… 올해는 축제를 할 수 있겠구나.",
     "who": "spool",
     "face": "happy"
    },
    {
     "say": [
      "그런데 현수막이 아직 축축하네.",
      "따뜻한 바람만 있으면 바로 시작할 텐데…"
     ],
     "who": "pip",
     "face": "sad"
    },
    {
     "say": "따뜻한 바람이라면 건조장에… 아니야, 아무것도.",
     "who": "pip",
     "face": "neutral"
    }
   ]
  },
  {
   "do": "cinema",
   "on": false
  }
 ],
 "town.postbox": [
  {
   "if": "!flag:letter_read && flag:mitt_given",
   "then": [
    {
     "say": [
      "양말 모양 우체통에 편지가 한 통 꽂혀 있다.",
      "받는 사람: {player}. 보낸 사람: 미트."
     ]
    },
    {
     "do": "item.add",
     "id": "mitt-letter"
    },
    {
     "set": {
      "letter_read": true
     }
    },
    {
     "say": "'{player}에게. 숲 끝의 등불 아래는 따뜻해요.'"
    },
    {
     "say": "'이제는 기다리는 편지 대신, 보내는 편지를 써요.'"
    },
    {
     "say": "'장갑 한 켤레가 된 기분은요… 손이 하나 더 생긴 기분이에요.'"
    },
    {
     "say": "'축제에 꼭 가 보세요. 짝이 없어도 괜찮은 축제래요. — 미트'"
    },
    {
     "do": "end"
    }
   ]
  },
  {
   "if": "!flag:letter_read && flag:mitt_kept",
   "then": [
    {
     "say": [
      "양말 모양 우체통에 편지가 한 통 꽂혀 있다.",
      "받는 사람: {player}. 보낸 사람: 미트."
     ]
    },
    {
     "do": "item.add",
     "id": "mitt-letter"
    },
    {
     "set": {
      "letter_read": true
     }
    },
    {
     "say": "'{player}에게. 장갑 한 짝을 간직해 줘서 고마워요.'"
    },
    {
     "say": "'저도 이 등불 아래에서, 그분을 간직하고 있어요.'"
    },
    {
     "say": "'우리 둘 다 한 짝씩이지만, 그래도 꽤 따뜻하죠? — 미트'"
    },
    {
     "do": "end"
    }
   ]
  },
  {
   "if": "!flag:letter_read && flag:mitt_joined && !flag:mitt_left",
   "then": [
    {
     "say": "우체통에 짧은 쪽지가 들어 있다."
    },
    {
     "do": "item.add",
     "id": "mitt-letter"
    },
    {
     "set": {
      "letter_read": true
     }
    },
    {
     "say": "'숲 끝까지 함께 와 줘서 고마웠어요. 잘 지내요. — 미트'"
    },
    {
     "do": "end"
    }
   ]
  },
  {
   "if": "flag:letter_read && !flag:letter_replied",
   "then": [
    {
     "say": "우체통이 비어 있다. 답장을 넣어 볼까?"
    },
    {
     "choice": [
      {
       "text": "(답장을 쓴다)",
       "then": [
        {
         "say": [
          "'잘 지내.'",
          "짧게 적어 넣었다. 우체통이 덜컹, 하고 기뻐한 것 같다."
         ]
        },
        {
         "set": {
          "letter_replied": true
         }
        }
       ]
      },
      {
       "text": "(그냥 둔다)",
       "then": [
        {
         "say": "우체통 입구가 조금 서운해 보인다."
        }
       ]
      }
     ]
    },
    {
     "do": "end"
    }
   ]
  },
  {
   "say": [
    "우체통이 비어 있다.",
    "누군가의 편지를 기다리는 것 같지는 않다."
   ]
  }
 ],
 "town.spool": [
  {
   "if": "hollow",
   "then": [
    {
     "say": [
      "가판대에 '임시 휴업'이라고 적혀 있다.",
      "안에서 바늘 소리가 들리다가, 멈췄다."
     ]
    },
    {
     "do": "end"
    }
   ]
  },
  {
   "if": "!flag:met_spool",
   "then": [
    {
     "set": {
      "met_spool": true
     }
    },
    {
     "say": "어서 오렴. 실타래 할머니의 수선집이란다.",
     "who": "spool",
     "face": "happy"
    },
    {
     "say": [
      "구멍 난 건 꿰매 주고, 풀린 건 감아 준단다.",
      "마음은… 그건 좀 어렵고."
     ],
     "who": "spool",
     "face": "neutral"
    }
   ]
  },
  {
   "if": "item:thread && !flag:spool_mended",
   "then": [
    {
     "say": "어머, 그 실… 숲에서 왔구나. 좋은 무명실이야.",
     "who": "spool",
     "face": "neutral"
    },
    {
