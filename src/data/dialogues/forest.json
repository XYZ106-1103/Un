   "do": "npc.hide",
   "id": "mitt"
  },
  {
   "do": "follower",
   "id": "mitt"
  },
  {
   "set": {
    "mitt_joined": true
   }
  },
  {
   "do": "cinema",
   "on": false
  }
 ],
