       "face": "happy"
      },
      {
       "do": "relation",
       "id": "mitt",
       "amount": 1
      }
     ]
    },
    {
     "text": "…알았어.",
     "then": [
      {
       "say": "네. 조용히 따라갈게요.",
       "who": "mitt",
       "face": "neutral"
      }
     ]
    }
